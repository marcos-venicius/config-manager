step@unix {
	label: "system update"
	groups: ["base"]

	up !<<{
		sudo apt-get update -y
		sudo apt-get upgrade -y
	>>}
}

step@unix {
	label: "Util Linux Extra"
	groups: ["base"]

	health !<<{
		which newgrp
	>>}

	up !<<{
		sudo apt-get install util-linux-extra -y
	>>}

	down !<<{
		sudo apt-get remove util-linux-extra -y
	>>}
}

step@unix {
	label: "Install Docker"
	groups: ["docker"]
	requires: ["base"]

	health !<<{
		which docker
	>>}

	up !<<{
		sudo apt-get remove $(dpkg --get-selections docker.io docker-compose docker-compose-v2 docker-doc docker-buildx podman-docker containerd runc | cut -f1) -y	
		sudo install -m 0755 -d /etc/apt/keyrings
		sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
		sudo chmod a+r /etc/apt/keyrings/docker.asc
		sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
			Types: deb
			URIs: https://download.docker.com/linux/ubuntu
			Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
			Components: stable
			Architectures: $(dpkg --print-architecture)
			Signed-By: /etc/apt/keyrings/docker.asc
		EOF

		sudo apt-get update -y
		sudo apt-get install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin -y
		sudo systemctl enable docker
		sudo systemctl start docker
		sudo groupadd docker || :
		sudo usermod -aG docker $(logname) || :
	>>}

	down !<<{
		sudo systemctl disable docker
		sudo apt purge docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-ce-rootless-extras
		sudo rm -rf /var/lib/docker
		sudo rm -rf /var/lib/containerd
		sudo rm /etc/apt/sources.list.d/docker.sources
		sudo rm /etc/apt/keyrings/docker.asc
	>>}
}
